# Copy to .env and fill in. Never commit .env.
# check-omniroute.sh reads OMNIROUTE_API_KEY from .env. For OmniRoute itself, set the other
# two values in your shell or inline on the start command shown in OMNIROUTE.md.

# Listen on this machine only
OMNIROUTE_SERVER_HOST=127.0.0.1

# Require an endpoint key for model requests
REQUIRE_API_KEY=true

# Endpoint key created in the OmniRoute dashboard (Endpoints), used by check-omniroute.sh
OMNIROUTE_API_KEY=
